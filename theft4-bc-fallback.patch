diff --git a/tests/bc_rgba8_fallback_test.cpp b/tests/bc_rgba8_fallback_test.cpp
new file mode 100644
index 00000000..d3631a54
--- /dev/null
+++ b/tests/bc_rgba8_fallback_test.cpp
@@ -0,0 +1,59 @@
+#include "bc_rgba8_fallback.h"
+#include <cstdio>
+#include <cstdlib>
+using namespace rex::graphics::gta4_native;
+struct Mip{uint32_t level=0,width=0,height=0,depth=1,base_array_layer=0,layer_count=1,buffer_row_length=0,buffer_image_height=0;size_t payload_offset=0,payload_size=0;};
+static int fails=0;
+#define CHECK(c) do{if(!(c)){printf("FAIL line %d: %s\n",__LINE__,#c);++fails;}}while(0)
+// solid RGB565 block: color0==color1, all selectors 0 -> opaque solid colour
+static void bc1(std::vector<uint8_t>&p,uint16_t c){uint8_t b[8]={uint8_t(c),uint8_t(c>>8),uint8_t(c),uint8_t(c>>8),0,0,0,0};p.insert(p.end(),b,b+8);}
+static void bc1_trans(std::vector<uint8_t>&p){uint8_t b[8]={0,0,0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};p.insert(p.end(),b,b+8);} // c0<=c1, selector 3 => transparent
+static void bc2(std::vector<uint8_t>&p,uint8_t a4,uint16_t c){for(int i=0;i<8;i++)p.push_back(a4|(a4<<4));bc1(p,c);}
+static void bc3(std::vector<uint8_t>&p,uint8_t a,uint16_t c){uint8_t b[8]={a,a,0,0,0,0,0,0};p.insert(p.end(),b,b+8);bc1(p,c);}
+static const uint8_t* px(const std::vector<uint8_t>&o,const Mip&m,uint32_t x,uint32_t y,uint32_t z=0){return o.data()+m.payload_offset+((size_t(z)*m.height+y)*m.width+x)*4;}
+int main(){
+  const uint16_t RED=0xF800,GREEN=0x07E0,BLUE=0x001F,WHITE=0xFFFF;
+  // 1) BC1, 6x5 (2x2 blocks, NPOT), mip0 + mip1 (3x2 -> 1x1 block), row padded to 3 blocks (buffer_row_length=12)
+  { std::vector<uint8_t> p; Mip m0; m0.level=0;m0.width=6;m0.height=5;m0.buffer_row_length=12;m0.buffer_image_height=8;
+    uint16_t cols[2][3]={{RED,GREEN,0},{BLUE,WHITE,0}};
+    for(int by=0;by<2;by++){for(int bx=0;bx<3;bx++)bc1(p,bx<2?cols[by][bx]:0x1234);} // padding block bx=2
+    m0.payload_size=p.size(); // 2 rows*3 blocks*8 -- but image_height=8 => 2 block rows ok
+    Mip m1; m1.level=1;m1.width=3;m1.height=2;m1.payload_offset=p.size();bc1(p,BLUE);m1.payload_size=8;
+    std::vector<Mip> in{m0,m1}; std::vector<uint8_t> out; std::vector<Mip> om;
+    CHECK(DecodeBcMipsToRgba8(BcFallbackKind::kBC1,p,in,1<<26,out,om)==BcFallbackResult::kOk);
+    CHECK(om.size()==2); CHECK(om[0].payload_size==6*5*4); CHECK(om[1].payload_offset==6*5*4); CHECK(om[1].payload_size==3*2*4);
+    CHECK(om[0].buffer_row_length==0); CHECK(om[0].level==0&&om[1].level==1);
+    // red block covers x0-3,y0-3 ; green x4-5,y0-3 ; blue x0-3,y4 ; white x4-5,y4
+    CHECK(px(out,om[0],0,0)[0]>240&&px(out,om[0],0,0)[1]<10&&px(out,om[0],3,3)[0]>240);
+    CHECK(px(out,om[0],4,0)[1]>240&&px(out,om[0],5,3)[1]>240&&px(out,om[0],5,3)[0]<10);
+    CHECK(px(out,om[0],0,4)[2]>240&&px(out,om[0],3,4)[2]>240);
+    CHECK(px(out,om[0],5,4)[0]>240&&px(out,om[0],5,4)[1]>240&&px(out,om[0],5,4)[2]>240);
+    CHECK(px(out,om[0],5,4)[3]==255);
+    CHECK(px(out,om[1],2,1)[2]>240&&px(out,om[1],2,1)[3]==255);
+    // out-of-image bytes untouched: total size exact
+    CHECK(out.size()==(6*5+3*2)*4);
+  }
+  // 2) BC1 transparency preserved
+  { std::vector<uint8_t> p; bc1_trans(p); Mip m;m.width=4;m.height=4;m.payload_size=8; std::vector<uint8_t> o;std::vector<Mip> om;
+    CHECK(DecodeBcMipsToRgba8(BcFallbackKind::kBC1,p,std::vector<Mip>{m},1<<26,o,om)==BcFallbackResult::kOk);
+    CHECK(px(o,om[0],0,0)[3]==0); }
+  // 3) BC2 alpha + BC3 alpha, 3D depth 3 (4x4x3), padded slices (image_height 8 => 2 block rows)
+  for(int k=0;k<2;k++){ std::vector<uint8_t> p; Mip m;m.width=4;m.height=4;m.depth=3;m.buffer_row_length=4;m.buffer_image_height=8;
+    uint8_t alphas[3]={0x0,0x8,0xF}; uint16_t cs[3]={RED,GREEN,BLUE};
+    for(int z=0;z<3;z++){ if(k==0)bc2(p,alphas[z],cs[z]);else bc3(p,alphas[z]*17,cs[z]); p.resize(p.size()+16); /*pad block row*/ }
+    m.payload_size=p.size(); std::vector<uint8_t> o;std::vector<Mip> om;
+    CHECK(DecodeBcMipsToRgba8(k?BcFallbackKind::kBC3:BcFallbackKind::kBC2,p,std::vector<Mip>{m},1<<26,o,om)==BcFallbackResult::kOk);
+    CHECK(om[0].payload_size==4*4*3*4);
+    for(int z=0;z<3;z++){ const uint8_t*q=px(o,om[0],2,2,z);
+      CHECK(abs(int(q[3])-alphas[z]*17)<=1);
+      CHECK(z==0?q[0]>240:z==1?q[1]>240:q[2]>240); } }
+  // 4) bad inputs rejected
+  { std::vector<uint8_t> p(8); Mip m;m.width=8;m.height=8;m.payload_size=8; std::vector<uint8_t> o;std::vector<Mip> om;
+    CHECK(DecodeBcMipsToRgba8(BcFallbackKind::kBC1,p,std::vector<Mip>{m},1<<26,o,om)==BcFallbackResult::kBadLayout);
+    m.payload_size=100; CHECK(DecodeBcMipsToRgba8(BcFallbackKind::kBC1,p,std::vector<Mip>{m},1<<26,o,om)==BcFallbackResult::kBadMip);
+    Mip z;CHECK(DecodeBcMipsToRgba8(BcFallbackKind::kBC1,p,std::vector<Mip>{z},1<<26,o,om)==BcFallbackResult::kBadMip);
+    Mip big;big.width=4;big.height=4;big.payload_size=8;CHECK(DecodeBcMipsToRgba8(BcFallbackKind::kBC1,p,std::vector<Mip>{big},32,o,om)==BcFallbackResult::kBadTotalSize); }
+  // 5) 1x1 and 2x2 mips (sub-block)
+  { std::vector<uint8_t> p; bc1(p,GREEN); Mip m;m.width=1;m.height=1;m.payload_size=8;std::vector<uint8_t> o;std::vector<Mip> om;
+    CHECK(DecodeBcMipsToRgba8(BcFallbackKind::kBC1,p,std::vector<Mip>{m},1<<26,o,om)==BcFallbackResult::kOk);CHECK(o.size()==4&&o[1]>240); }
+  printf(fails?"FAILED %d\n":"ALL PASS\n",fails); return fails?1:0; }
