@@ -0,0 +1,118 @@
+#pragma once
+// Software BC1/BC2/BC3 -> RGBA8 decode used when the Vulkan device (for
+// example Apple A-series GPUs through MoltenVK) cannot sample BC formats.
+// Header-only and templated on the mip descriptor so it can be unit tested
+// without the renderer.
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+extern "C" {
+#include "libavcodec/texturedsp.h"
+}
+
+namespace rex::graphics::gta4_native {
+
+enum class BcFallbackKind { kBC1, kBC2, kBC3 };
+
+enum class BcFallbackResult {
+  kOk,
+  kInitFailed,
+  kBadMip,
+  kBadLayout,
+  kBadSize,
+  kBadTotalSize,
+};
+
+inline size_t BcFallbackBlockBytes(BcFallbackKind kind) {
+  return kind == BcFallbackKind::kBC1 ? 8 : 16;
+}
+
+// MipT needs: width, height, depth, buffer_row_length, buffer_image_height
+// (texels, 0 = tightly packed), payload_offset, payload_size.
+// Every input mip entry (one array layer, or one whole 3D level) is decoded
+// into a tightly packed RGBA8 entry in `out_mips` / `out_payload`; all other
+// fields (level, base_array_layer, layer_count) are copied unchanged.
+template <typename MipT>
+BcFallbackResult DecodeBcMipsToRgba8(BcFallbackKind kind, const std::vector<uint8_t>& payload,
+                                     const std::vector<MipT>& mips, size_t max_total_bytes,
+                                     std::vector<uint8_t>& out_payload,
+                                     std::vector<MipT>& out_mips) {
+  TextureDSPContext dsp{};
+  ff_texturedsp_init(&dsp);
+  int (*decode_block)(uint8_t*, ptrdiff_t, const uint8_t*) =
+      kind == BcFallbackKind::kBC1   ? dsp.dxt1a_block  // keeps 1-bit transparency
+      : kind == BcFallbackKind::kBC2 ? dsp.dxt3_block
+                                     : dsp.dxt5_block;
+  if (!decode_block) {
+    return BcFallbackResult::kInitFailed;
+  }
+  const size_t block_bytes = BcFallbackBlockBytes(kind);
+  out_payload.clear();
+  out_mips.clear();
+  out_mips.reserve(mips.size());
+
+  for (const MipT& mip : mips) {
+    if (!mip.width || !mip.height || !mip.depth || mip.payload_offset > payload.size() ||
+        mip.payload_size > payload.size() - mip.payload_offset) {
+      return BcFallbackResult::kBadMip;
+    }
+    const uint32_t blocks_x = (mip.width + 3) / 4;
+    const uint32_t blocks_y = (mip.height + 3) / 4;
+    const uint32_t src_blocks_per_row =
+        mip.buffer_row_length ? (mip.buffer_row_length + 3) / 4 : blocks_x;
+    const uint32_t src_block_rows =
+        mip.buffer_image_height ? (mip.buffer_image_height + 3) / 4 : blocks_y;
+    const size_t src_row_bytes = size_t(src_blocks_per_row) * block_bytes;
+    const size_t src_slice_bytes = size_t(src_block_rows) * src_row_bytes;
+    // The last slice only needs its used rows to be present.
+    const size_t src_required =
+        size_t(mip.depth - 1) * src_slice_bytes + size_t(blocks_y) * src_row_bytes;
+    if (src_blocks_per_row < blocks_x || src_block_rows < blocks_y ||
+        src_required > mip.payload_size) {
+      return BcFallbackResult::kBadLayout;
+    }
+    const uint64_t decoded_size =
+        uint64_t(mip.width) * mip.height * mip.depth * 4ull;
+    if (decoded_size > std::numeric_limits<size_t>::max()) {
+      return BcFallbackResult::kBadSize;
+    }
+    // Keep 4-byte alignment for each VkBufferImageCopy offset (size is already
+    // a multiple of 4, so offsets stay aligned).
+    const size_t dst_offset = out_payload.size();
+    if (decoded_size > max_total_bytes || dst_offset > max_total_bytes - size_t(decoded_size)) {
+      return BcFallbackResult::kBadTotalSize;
+    }
+    out_payload.resize(dst_offset + size_t(decoded_size));
+    const uint8_t* src = payload.data() + mip.payload_offset;
+    uint8_t* dst = out_payload.data() + dst_offset;
+    uint8_t block[4 * 4 * 4];
+    for (uint32_t z = 0; z < mip.depth; ++z) {
+      for (uint32_t by = 0; by < blocks_y; ++by) {
+        for (uint32_t bx = 0; bx < blocks_x; ++bx) {
+          const uint8_t* sb = src + size_t(z) * src_slice_bytes + size_t(by) * src_row_bytes +
+                              size_t(bx) * block_bytes;
+          decode_block(block, 4 * 4, sb);
+          const uint32_t w = std::min<uint32_t>(4, mip.width - bx * 4);
+          const uint32_t h = std::min<uint32_t>(4, mip.height - by * 4);
+          for (uint32_t py = 0; py < h; ++py) {
+            std::memcpy(dst + ((size_t(z) * mip.height + by * 4 + py) * mip.width + bx * 4) * 4,
+                        block + size_t(py) * 16, size_t(w) * 4);
+          }
+        }
+      }
+    }
+    MipT out = mip;
+    out.payload_offset = dst_offset;
+    out.payload_size = size_t(decoded_size);
+    out.buffer_row_length = 0;
+    out.buffer_image_height = 0;
+    out_mips.push_back(out);
+  }
+  return BcFallbackResult::kOk;
+}
+
+}  // namespace rex::graphics::gta4_native
